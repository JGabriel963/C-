{
  "openapi": "3.1.1",
  "info": {
    "title": "BarberShop.API | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7012"
    },
    {
      "url": "http://localhost:5173"
    }
  ],
  "paths": {
    "/api/billings": {
      "post": {
        "tags": [
          "Billings"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestInvoiceJson"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestInvoiceJson"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RequestInvoiceJson"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegisteredInvoiceJson"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegisteredInvoiceJson"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResponseRegisteredInvoiceJson"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RequestInvoiceJson": {
        "type": "object",
        "properties": {
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "barberName": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "serviceName": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "paymentMethod": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ResponseRegisteredInvoiceJson": {
        "type": "object",
        "properties": {
          "barberName": {
            "type": "string"
          },
          "clientName": {
            "type": "string"
          },
          "serviceName": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Billings"
    }
  ]
}